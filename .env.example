# ============================================================
# Vira environment configuration
# Copy to `.env` — never commit `.env`.
# ============================================================

# PostgreSQL (required, server-side only)
# Development (local):
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# Production (Neon): append sslmode=require — node-postgres picks this up.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.neon.tech/vira?sslmode=require&channel_binding=require"
DB_SSL_REJECT_UNAUTHORIZED="true"

# Google OAuth (Auth.js)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
# Generate a long random secret; production refuses to start without AUTH_SECRET.
AUTH_SECRET="replace-with-a-long-random-secret"

# Explicitly enable only for a trusted Arena preview that embeds Vira cross-site.
# Keep false/unset for normal production deployments.
ARENA_PREVIEW="false"

# Resend (email verification + password reset)
# If omitted, dev uses a structured console outbox instead of sending.
RESEND_API_KEY="re_xxxxxxx"
EMAIL_FROM="Vira <no-reply@your-domain.com>"

# Canonical base URL used when generating email links.
APP_URL="http://localhost:3000"

# Optional: shared rate limiting (Upstash Redis, multi-instance safe)
UPSTASH_REDIS_REST_URL="https://your-endpoint.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"
